From b32e65490a6d9aa3f0c40e185692cf8471f30865 Mon Sep 17 00:00:00 2001
From: i-shenl <i-shenl@activestate.com>
Date: Fri, 13 Aug 2021 13:06:58 -0700
Subject: [PATCH] use local built libsodium

---
 setup.py | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 9319c1c..f7b7fb6 100644
--- a/setup.py
+++ b/setup.py
@@ -129,6 +129,9 @@ class build_clib(_build_clib):
     def run(self):
         if use_system():
             return
+        
+        if "SODIUM_HOME" in os.environ:
+            return
 
         # use Python's build environment variables
         build_env = {key: val for key, val in
@@ -193,6 +196,18 @@ class build_clib(_build_clib):
 class build_ext(_build_ext):
 
     def run(self):
+        if "SODIUM_HOME" in os.environ:
+            sodium_home = os.getenv("SODIUM_HOME")
+            self.include_dirs.append(
+                os.path.join(sodium_home, "include")
+            )
+            self.library_dirs.insert(
+                0, os.path.join(sodium_home, "lib")
+            )
+            self.library_dirs.insert(
+                0, os.path.join(sodium_home, "lib64")
+            )
+            
         if self.distribution.has_c_libraries():
             build_clib = self.get_finalized_command("build_clib")
             self.include_dirs.append(
@@ -204,7 +219,7 @@ class build_ext(_build_ext):
             self.library_dirs.insert(
                 0, os.path.join(build_clib.build_clib, "lib"),
             )
-
+        
         return _build_ext.run(self)
 
 
