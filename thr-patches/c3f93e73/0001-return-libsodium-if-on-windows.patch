From: i-shenl <i-shenl@activestate.com>
Date: Mon, 25 Oct 2021 12:54:21 -0700
Subject: [PATCH] return libsodium if on windows

---
 setup.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index f7b7fb6..aff40e8 100644
--- a/setup.py
+++ b/setup.py
@@ -124,7 +124,10 @@ class build_clib(_build_clib):
         raise Exception("check_library_list")
 
     def get_library_names(self):
-        return ["sodium"]
+        if platform.system() == "Windows":
+            return ["libsodium"]
+        else:
+            return ["sodium"]
 
     def run(self):
         if use_system():
